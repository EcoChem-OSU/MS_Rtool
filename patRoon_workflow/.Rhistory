# -----------------------------
# check and produced subDir folder
# -----------------------------
#February 2017 B.DROZ
# modified on the 18/8/2022 to
creat.subDir <- function (mainDir,subDir)
{
if ( dir.exists(paste(mainDir,"/",subDir, sep="") ) ){
i <- 1
while( file.exists( paste(mainDir,"/",subDir,"_",i, sep="") ) )
{i <-i+1}
dir.create(file.path(mainDir, paste(subDir,"_",i, sep="") ))
outpath <- file.path(mainDir, paste(subDir,"_",i, sep=""))
} else {
dir.create(file.path(mainDir, subDir))
outpath <- file.path(mainDir, subDir)
}
return(outpath)
}
##### modified 2025-12-23
# is_empty_or_na <- function(x) {
#   if (is.null(x)) return(TRUE)
#   if (length(x) == 0) return(TRUE)
#   all(is.na(x) | trimws(x) == "" | toupper(x) == "NA")
# }
# -------------------------
# Helpers for emptiness
# -------------------------
is_empty_or_na <- function(x) {
# Treat NULL or zero-length as empty
if (is.null(x) || length(x) == 0) return(TRUE)
# Atomic vectors: consider NA / blank / literal "NA" (case-insensitive) as empty
if (is.atomic(x)) {
tx <- trimws(as.character(x))
return(all(is.na(x) | tx == "" | toupper(tx) == "NA"))
}
# Fallback (lists/data frames not expected as values)
FALSE }
# -----------------------------
# Read lines safe
# -----------------------------
read_lines_safe <- function(path) {
if (!file.exists(path)) stop("Input file not found: ", path)
x <- readLines(path, warn = FALSE)
# Normalize encoding to UTF-8
Encoding(x) <- "UTF-8"
x
}
# -----------------------------
# Split into sections
# -----------------------------
# split_sections <- function(lines, start_regex) {
#   starts <- which(grepl(start_regex, lines, perl = TRUE))
#   if (length(starts) == 0L) {
#     # Fallback: split by long dashed lines or blank blocks
#     starts <- which(grepl("^\\s*-{3,}\\s*$|^\\s*=+\\s*$", lines))
#   }
#   if (length(starts) == 0L) {
#     # Single section fallback
#     return(list(lines))
#   }
#   starts <- sort(unique(c(starts)))
#   ends <- c(starts[-1] - 1L, length(lines))
#   sections <- Map(function(s, e) lines[s:e], starts, ends)
#   sections
# }
split_sections <- function(lines,
start_regex,
include_preamble = TRUE,
fallback_sep_regex = "^\\s*-{3,}\\s*$|^\\s*=+\\s*$") {
if (!is.character(lines)) stop("'lines' must be a character vector.")
n <- length(lines)
if (n == 0L) return(list(character(0)))
# 1) Primary detection: positions where a section "starts" by start_regex
starts <- which(grepl(start_regex, lines, perl = TRUE))
# 2) Fallback: if no starts, split by long dashed/equals lines (as separators)
#    We treat these separator lines as "boundaries" and keep everything else intact.
if (length(starts) == 0L) {
seps <- which(grepl(fallback_sep_regex, lines))
if (length(seps) == 0L) {
# No starts, no separators -> single section, keep empty lines as-is
return(list(lines))
}
# Compute starts/ends around separators
# Sections are: [1, seps[1]-1], [seps[1]+1, seps[2]-1], ..., [seps[k]+1, n]
starts <- c(1L, seps + 1L)
ends <- c(seps - 1L, n)
# Remove any ranges where start > end (e.g., consecutive separators)
keep <- starts <= ends
starts <- starts[keep]
ends <- ends[keep]
sections <- Map(function(s, e) lines[s:e], starts, ends)
return(sections)
}
# 3) Normalize and ensure starts are sorted unique
starts <- sort(unique(starts))
# 4) If preamble exists and we want to keep it, prepend index 1
if (include_preamble && starts[1] > 1L) {
starts <- c(1L, starts)
}
# 5) Compute ends for each start (end is previous start - 1, except last -> n)
ends <- c(starts[-1] - 1L, n)
# 6) Build sections without dropping empty lines
sections <- Map(function(s, e) {
if (s > e) return(character(0))  # safety for odd indexes
lines[s:e]
}, starts, ends)
sections
}
# ----------------
# paste with all sep
# -----------------
safe_collapse <- function(..., sep = "; ") {
parts <- list(...)
# Flatten list to a simple character vector
parts <- unlist(parts, use.names = FALSE)
# Keep only meaningful values
parts <- Filter(function(x) !is.null(x) && !is.na(x) && nzchar(trimws(x)), parts)
# Collapse or return empty string if nothing left
if (length(parts) == 0) "" else paste(parts, collapse = sep)
}
# -------------------------
# Occurrence-aware getter
# -------------------------
get_nth <- function(lst, key, n) {
v <- lst[[key]]
if (is.null(v)) return(NULL)
if (length(v) >= n) return(v[n])
if (length(v) == 1) return(v)    # reuse a single value for multiple occurrences
NULL
}
# ------------------------
# Fill with defaults and drop empty lines
# -------------------------
fill_with_defaults <- function(keys, user_values = list(), defaults = list(), drop_empty = TRUE) {
unique_keys <- unique(keys)
seen <- setNames(integer(length(unique_keys)), unique_keys)
out <- character(0)
for (k in keys) {
seen[k] <- seen[k] + 1
n <- seen[k]
# Prefer user value; fallback to default
val <- get_nth(user_values, k, n)
if (is_empty_or_na(val)) {
val <- get_nth(defaults, k, n)
}
# If still empty, either drop or keep blank
if (is_empty_or_na(val)) {
if (!drop_empty) {
out <- c(out, paste0(k, ""))
}
# else: skip adding this line entirely
} else {
out <- c(out, paste0(k, " ", trimws(as.character(val))))
}
}
out
}
# Spectrum append (two leading spaces, one space between columns)
# -------------------------
format_spectrum_lines <- function(df) {
stopifnot(ncol(df) >= 3)
mz <- df[[1]]
intensity <- df[[2]]
relative_int <- df[[3]]
# Ensure numeric and drop rows with NA
mz <- as.numeric(mz)
intensity <- as.numeric(intensity)
relative_int <- as.numeric(relative_int)
#keep <- !(is.na(mz) | is.na(intensity)| is.na(relative_int))
#mz <- mz[keep]
#intensity <- intensity[keep]
#relative_int <- relative_int[keep]
# Use format() to preserve decimals without scientific notation
paste0("  ",
format(mz, scientific = FALSE, trim = TRUE),
" ",
format(intensity, scientific = FALSE, trim = TRUE),
" ",
format(relative_int, scientific = FALSE, trim = TRUE))
}
